# Webhook Security
# -----------------------------
WEBHOOK_SECRET=supersecret_12345

# -----------------------------
# Core Application
# -----------------------------
NODE_ENV=development
PORT=3000

# -----------------------------
# MongoDB
# -----------------------------
MONGO_URI=mongodb://localhost:27017/faxnova

# -----------------------------
# Redis (Codespaces / Local)
# -----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------
# Authentication
# -----------------------------
JWT_SECRET=supersecretjwtkey
JWT_ADMIN_SECRET=supersecretadminjwtkey

# -----------------------------
# Telnyx Provider
# -----------------------------
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_WEBHOOK_SECRET=your_telnyx_webhook_secret

# -----------------------------
# Sinch Provider (REST Adapter)
# -----------------------------
SINCH_API_KEY=your_sinch_api_key
SINCH_API_SECRET=your_sinch_api_secret
SINCH_PROJECT_ID=your_sinch_project_id

# -----------------------------
# Storage (S3 or Local)
