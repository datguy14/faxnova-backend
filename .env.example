# ============================================
# FaxNova Backend - Environment Configuration
# ============================================

# -------------------------
# Server Configuration
# -------------------------
PORT=3000
NODE_ENV=production

# -------------------------
# Logging & Security
# -------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# -------------------------
# Sinch Provider
# -------------------------
SINCH_API_KEY=
SINCH_API_SECRET=
SINCH_SERVICE_PLAN_ID=
SINCH_FAX_NUMBER=

# -------------------------
# Telnyx Provider
# -------------------------
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FAX_NUMBER=

# -------------------------
# Application
# -------------------------
APP_URL=https://your-domain.com
JWT_SECRET=change_this_to_a_long_random_string

# -------------------------
# Optional Features
# -------------------------
ENABLE_PROVIDER_FAILOVER=true
PRIMARY_PROVIDER=sinch
