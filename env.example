# -----------------------------
# Server
# -----------------------------
PORT=3000
NODE_ENV=development

# -----------------------------
# MongoDB
# -----------------------------
# Replace <username> and <password> with your Atlas user credentials.
# The database name should be "faxnova" (not test).
MONGO_URI=mongodb+srv://<username>:<password>@faxnova-db.xxxxx.mongodb.net/faxnova?retryWrites=true&w=majority

# -----------------------------
# Sinch Fax API
# -----------------------------
SINCH_API_KEY=
SINCH_API_SECRET=
SINCH_REGION=us
SINCH_FAX_NUMBER=

# -----------------------------
# API Key System
# -----------------------------
# Used to hash API keys before storing them.
API_KEY_HASH_SECRET=

# -----------------------------
# Rate Limits (per tier)
# -----------------------------
FREE_PER_MINUTE=10
FREE_PER_DAY=200

PRO_PER_MINUTE=60
PRO_PER_DAY=2000

BUSINESS_PER_MINUTE=200
BUSINESS_PER_DAY=10000

# -----------------------------
# Admin / Security
# -----------------------------
# Required to access /admin/audit/logs
ADMIN_AUDIT_KEY=

# -----------------------------
# Audit Viewer Key (your request)
# -----------------------------
AUDIT_VIEWER_KEY=
