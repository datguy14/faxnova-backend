# =====================================================
# Server Configuration
# =====================================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# =====================================================
# Database
# =====================================================
# MongoDB (Atlas recommended)
MONGO_URI=mongodb+srv://<username>:<password>@faxnova-db.xxxxx.mongodb.net/faxnova?retryWrites=true&w=majority

# =====================================================
# Fax Providers - Multi-Provider Routing
# =====================================================

# Default provider: sinch | telnyx | hybrid
DEFAULT_FAX_PROVIDER=sinch

# ------------------- Sinch -------------------
SINCH_API_KEY=
SINCH_API_SECRET=
SINCH_REGION=us
SINCH_FAX_NUMBER=   # Your dedicated Sinch fax number (E.164 format)

# ------------------- Telnyx -------------------
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=          # Required for outbound faxes
TELNYX_FROM_NUMBER=            # Default sending number (E.164)

# ------------------- Routing & Fallback -------------------
ENABLE_PROVIDER_FALLBACK=true
FALLBACK_DELAY_MS=3000

# Smart routing (future extension)
# Example: healthcare → sinch, high-volume → telnyx
ENABLE_SMART_ROUTING=false

# =====================================================
# Authentication & Security
# =====================================================
API_KEY_HASH_SECRET=your-strong-secret-key-here-min-32-chars

# JWT for future dashboard / admin access
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Admin access keys
ADMIN_AUDIT_KEY=your-admin-key-here
AUDIT_VIEWER_KEY=your-viewer-key-here

# Webhook verification
WEBHOOK_SECRET=your-webhook-verification-secret

# =====================================================
# Rate Limiting (per tier)
# =====================================================
FREE_PER_MINUTE=10
FREE_PER_DAY=200

PRO_PER_MINUTE=60
PRO_PER_DAY=2000

BUSINESS_PER_MINUTE=200
BUSINESS_PER_DAY=10000

# =====================================================
# Billing / Stripe (for monetization)
# =====================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Connect customer usage to billing
ENABLE_USAGE_BILLING=false

# =====================================================
# Logging & Observability
# =====================================================
LOG_FORMAT=json
ENABLE_REQUEST_LOGGER=true
ENABLE_AUDIT_FILE_LOG=true

# =====================================================
# Email (for notifications, alerts, fax-to-email)
# =====================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com

# =====================================================
# Redis (optional - for token caching, rate limits, queues)
# =====================================================
REDIS_URL=redis://localhost:6379
# or Redis Cloud / Upstash
# REDIS_URL=rediss://:password@...

# =====================================================
# Miscellaneous
# =====================================================
MAX_FILE_SIZE_MB=25
DEFAULT_RETRY_ATTEMPTS=3
MAX_PAGES_PER_FAX=100

# Domain verification (for public .well-known)
DOMAIN_VERIFICATION_ENABLED=true
