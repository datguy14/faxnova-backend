# =====================================================
# Server Configuration
# =====================================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# =====================================================
# MongoDB (Atlas)
# =====================================================
# Replace <username> and <password> with your Atlas user credentials.
# Database name should be "faxnova" for production consistency.
MONGO_URI=mongodb+srv://<username>:<password>@faxnova-db.xxxxx.mongodb.net/faxnova?retryWrites=true&w=majority

# =====================================================
# Sinch Fax API
# =====================================================
SINCH_API_KEY=
SINCH_API_SECRET=
SINCH_REGION=us
SINCH_FAX_NUMBER=

# =====================================================
# Authentication / Security
# =====================================================
# Used to hash API keys before storing them.
API_KEY_HASH_SECRET=

# Used for future JWT-based authentication (buyers love seeing this).
JWT_SECRET=

# Required to access /admin/audit/logs
ADMIN_AUDIT_KEY=

# Optional: separate viewer key for dashboards or internal tools.
AUDIT_VIEWER_KEY=

# =====================================================
# Rate Limits (per tier)
# =====================================================
FREE_PER_MINUTE=10
FREE_PER_DAY=200

PRO_PER_MINUTE=60
PRO_PER_DAY=2000

BUSINESS_PER_MINUTE=200
BUSINESS_PER_DAY=10000

# =====================================================
# Logging / Observability
# =====================================================
# Enable structured JSON logs (recommended for production).
LOG_FORMAT=json

# Enable request logging (true/false)
ENABLE_REQUEST_LOGGER=true

# Enable audit logging to file (true/false)
ENABLE_AUDIT_FILE_LOG=true
